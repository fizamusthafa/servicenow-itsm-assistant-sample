SERVICENOW_INSTANCE=https://dev12345.service-now.com
PORT=3001

# Auth mode:
#   oauth → each request must carry the signed-in user's ServiceNow OAuth access
#           token (sent by Copilot Studio). Recommended for anything shared.
#   basic → one shared service account for every caller (local dev / Cowork demo).
AUTH_MODE=basic

# Only used when AUTH_MODE=basic
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your-password-here

# Optional: max MCP requests per client IP per minute (default 600)
# RATE_LIMIT_PER_MINUTE=600
